# 配置示例
#
# 1. 先复制成正式配置文件
#    cp .env.dashboard.example .env.dashboard
# 2. 默认先跑模拟盘，确认稳定后再开实盘
# 3. 不要把真实私钥提交到 git
#
# -------- 实盘并行开关
# 纸面交易默认作为基线运行。
# false = 只跑纸面测试
# true  = 在纸面交易旁边并行启动实盘交易（需实盘凭证通过校验）
LIVE_TRADING_ENABLED=false
# paper = 纸面基线 / dashboard 默认视角
# live  = 实盘配置视角 / 目标运行模式
TRADE_MODE=paper

# -------- 实盘凭证
# POLYMARKET_PRIVATE_KEY 填实盘钱包私钥
# POLYMARKET_FUNDER 填对应的钱包地址（0x...）
# 留空表示未配置；实盘时必须填写
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_ORDER_TYPE=FOK

# CLOB API 凭证；留空时运行时会尝试由私钥派生。
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# -------- 官方 gasless 自动赎回
# 自动赎回需要走 Polymarket Relayer。下面两组凭证二选一：
# 1) 推荐：Relayer API key，在 Polymarket Settings > API Keys 创建。
#    官方文档中的 RELAYER_API_KEY / RELAYER_API_KEY_ADDRESS 映射到本项目的
#    POLYMARKET_RELAYER_API_KEY / POLYMARKET_RELAYER_API_KEY_ADDRESS。
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# 2) 兼容旧 Builder signing key；已有 Builder key 时可继续使用。
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

LIVE_AUTO_REDEEM_ENABLED=false
LIVE_AUTO_REDEEM_DRY_RUN=true
LIVE_AUTO_REDEEM_POLL_SECONDS=20
LIVE_AUTO_REDEEM_MAX_RETRIES=6
LIVE_AUTO_REDEEM_INITIAL_BACKOFF_SECONDS=30
LIVE_AUTO_REDEEM_MAX_BACKOFF_SECONDS=300

# -------- 基础策略
# STRATEGY_ID 是当前页面查看和策略说明使用的主策略。
# PAPER_STRATEGY_IDS 和 LIVE_STRATEGY_IDS 分别控制纸面和实盘策略组合。
# STRATEGY_IDS 只作为兼容旧配置的统一策略组合。
STRATEGY_ID=2
PAPER_STRATEGY_IDS=2
LIVE_STRATEGY_IDS=2
# 纸面模式模拟钱包余额；纸面不会读取真实钱包，但会经过与实盘相同的预算检查节点。
PAPER_SIMULATED_WALLET_BALANCE=1000000.0

# -------- 每个策略自己的参数
# 只支持 STRATEGY_<id>_<参数名>，纸面和实盘共用同一套策略参数。
# 下单模式固定为每轮 BASE_ORDER_COST，不再支持亏损后加注/回补。
STRATEGY_2_BASE_ORDER_COST=1.0
STRATEGY_2_MAX_CONSECUTIVE_LOSSES=6
STRATEGY_2_MAX_STAKE=15.0
STRATEGY_2_MAX_ENTRY_PRICE=0.65

# 策略 7 示例：纯固定金额，不追亏。
STRATEGY_7_BASE_ORDER_COST=1.2
STRATEGY_7_MAX_ENTRY_PRICE=0.54
STRATEGY_7_MIN_ENTRY_PRICE=0.48
STRATEGY_7_MAX_CONSECUTIVE_LOSSES=7
STRATEGY_7_OFI_THRESHOLD=0.58
STRATEGY_7_MOMENTUM_THRESHOLD=0.008

# 策略 10 示例：估值优势。
STRATEGY_10_MIN_EDGE=0.04
STRATEGY_10_EDGE_BUFFER=0.005
STRATEGY_10_OFI_WEIGHT=0.08
STRATEGY_10_MOMENTUM_WEIGHT=1.0
STRATEGY_10_MAX_FAIR_VALUE=0.85
STRATEGY_10_CONFIRM_BEFORE_ENTRY_SECONDS=0

# 策略 11 示例：BTC 概率定价。
STRATEGY_11_BASE_ORDER_COST=1.2
STRATEGY_11_MIN_STAKE=1.05
STRATEGY_11_MIN_ENTRY_PRICE=0.50
STRATEGY_11_MAX_ENTRY_PRICE=0.54
STRATEGY_11_BINANCE_SIGNAL_STALE_SECONDS=5.0
STRATEGY_11_MIN_EDGE=0.04
STRATEGY_11_EDGE_BUFFER=0.005
STRATEGY_11_VOLATILITY_BPS_PER_SQRT_MINUTE=18.0
STRATEGY_11_MIN_PROBABILITY=0.55
STRATEGY_11_MAX_PROBABILITY=0.95
STRATEGY_11_CONFIRM_BEFORE_ENTRY_SECONDS=2

# -------- 连接与保护
MAX_STAKE_SKIP_ALERT_THRESHOLD=5
WS_ENABLED=true
WS_QUOTE_STALE_SECONDS=3
WS_TRADE_GUARD_STALE_SECONDS=1.5
WS_CONNECT_TIMEOUT_SECONDS=5
WS_PING_INTERVAL_SECONDS=10

# -------- 倍投法（Martingale）实盘实验参数（默认关闭）
# 启用后，每次连输会将下注额乘以 MARTINGALE_MULTIPLIER^consecutive_losses。
# MARTINGALE_MAX_STAKE 是硬顶，超过此金额的订单会被跳过（不重置连亏计数器）。
# MARTINGALE_ENABLED=false
# MARTINGALE_MULTIPLIER=2.0
# MARTINGALE_MAX_STAKE=32.0
